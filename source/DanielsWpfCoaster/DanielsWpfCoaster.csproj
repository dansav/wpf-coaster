<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net46</TargetFrameworks>
    <UseWPF>true</UseWPF>
    
    <!-- Package Information -->
    <PackageId>DanielsWpfCoaster</PackageId>
    <Title>DanielsWpfCoaster</Title>
    <Description>WPF window placement utilities - automatically persist and restore window size, position, and state across application sessions</Description>
    <Authors>dansav</Authors>
    <Company>dansav</Company>
    <PackageTags>wpf window placement position persistence</PackageTags>
    <PackageProjectUrl>https://github.com/dansav/wpf-coaster</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dansav/wpf-coaster</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    
    <!-- Generate NuGet package on build -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    
    <!-- MinVer for git-based versioning -->
    <MinVerDefaultPreReleaseIdentifiers>preview</MinVerDefaultPreReleaseIdentifiers>
    <MinVerVerbosity>minimal</MinVerVerbosity>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>
